{
  "name": "coc-iiot-talk-2026-presentation",
  "version": "1.0.0",
  "description": "Reveal.js Docker setup for creating and presenting AsciiDoc-based presentations",
  "main": "src/scripts/watch.js",
  "scripts": {
    "build": "node src/scripts/compile.js",
    "dev": "node src/scripts/watch.js",
    "export:pdf": "python src/scripts/export_presentation.py",
    "test:python": "python -m unittest discover -s src/tests",
    "test:js": "jest",
    "test": "npm run test:python && npm run test:js",
    "clean": "rm -rf output/ docs/exports/"
  },
  "dependencies": {
    "@asciidoctor/core": "^3.0.0",
    "@asciidoctor/reveal.js": "^5.0.0",
    "chokidar": "^3.6.0",
    "fs-extra": "^11.2.0",
    "live-server": "^1.2.2",
    "reveal.js": "^5.1.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "puppeteer": "^22.0.0"
  }
}